// Avoid check spelling in:
// * RST comments
// * RST code blocks
// * "Mispellings" inside paths, or other RST directives
{
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "source/others/useful-ml-resources.rst"
  ],
  "ignoreRegExpList": [
    "/^([ \\t]*)\\.\\.\\s+(?:code|code-block|literalinclude)::.*(?:\\n(?:\\1[ \\t]+.*|$))*/gm",
    "::\\n\\n(?:[ ]{2,}.*\\n|\\n)*",
    "/^\\s*\\.\\.\\s+(?!(code|code-block|literalinclude)::)[^\\n]*(\\n([ ]{2,}|\\t)[^\\n]*)*/gm",
    "/:(?:material-[a-z0-9_-]+|fa[sb]?):`[^`]+`/g",
    "/<[^>\\n]+>/g",
    "/`+[^`\\n]+`+/g",
    "/:(?:ref|doc):`[^`]+`/g",
    "/\\|[a-zA-Z0-9_-]+\\|/g"
  ],
"words": [
    "AARC",
    "autoencoder",
    "bioimaging",
    "Caballer",
    "CARML",
    "codecarbon",
    "Convolutional",
    "Cowsay",
    "cowsay",
